# ------------------------------------------------------------------
# QA — environment configuration. Copy to `.env` for local overrides.
# All values below have sane defaults for `docker compose up`.
# ------------------------------------------------------------------

# --- Database ---
POSTGRES_DB=qa
POSTGRES_USER=qa
POSTGRES_PASSWORD=qa_dev_password

# --- Backend ---
# Connection string used by the backend service (composed from the above).
DATABASE_URL=postgres://qa:qa_dev_password@db:5432/qa
PORT=4000

# Session / JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seeded admin (guaranteed on first boot — see README)
ADMIN_EMAIL=admin@qa.local
ADMIN_PASSWORD=admin-password

# Webhook outbound signature secret (optional, for signing outbound webhooks)
WEBHOOK_SECRET=

# --- Frontend (baked at build time; VITE_* only) ---
VITE_API_BASE_URL=/api
