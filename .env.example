# SCHOLARION environment configuration
# Copy to .env and adjust. Documented defaults are safe for local dev only.

# --- Database ---
POSTGRES_USER=scholarion
POSTGRES_PASSWORD=scholarion
POSTGRES_DB=scholarion
POSTGRES_PORT=5432
DATABASE_URL=postgres://scholarion:scholarion@db:5432/scholarion

# --- Backend ---
PORT=3000
API_PORT=3000
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
PUBLIC_BASE_URL=http://localhost:8080

# --- Seeded admin (MUST be passed through docker-compose) ---
ADMIN_EMAIL=admin@scholarion.local
ADMIN_PASSWORD=Admin12345!

# --- School ---
SCHOOL_SLUG=scholarion-academy

# --- Frontend ---
WEB_PORT=8080
VITE_API_BASE_URL=/api