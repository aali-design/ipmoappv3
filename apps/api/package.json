{
  "name": "@ipmo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ipmo MVP API: auth + projects & tasks domain",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
